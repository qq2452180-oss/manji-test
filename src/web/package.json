{
  "name": "manji-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "dev": "vite --mode manji",
    "build": "vite build --mode manji",
    "build:html": "vite build --mode html-static",
    "package:html": "npm run build:html && node scripts/package-html.mjs",
    "build:watch": "vite build --watch --mode manji",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": { "vue": "3.5.43" },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
