# 将需要的配置复制到 src/.env；不要提交真实密钥。
# 默认关闭。未启用或配置无效时仅 RTC 接口返回 503，其他接口继续工作。
MANJI_LANGGRAPH_RTC_ENABLED=false

# 腾讯云 API 凭证、TRTC 应用 ID 与应用密钥。
MANJI_LANGGRAPH_RTC_SDK_APP_ID=
MANJI_LANGGRAPH_RTC_SECRET_ID=
MANJI_LANGGRAPH_RTC_SECRET_KEY=
MANJI_LANGGRAPH_RTC_SDK_SECRET_KEY=
# 与腾讯控制台该应用的“高级权限控制”保持一致；开启时设为 true。
MANJI_LANGGRAPH_RTC_ROOM_AUTH_ENABLED=false

# 指向本服务的桥接路由（公网 HTTPS 可达），由现有访谈服务使用对话历史生成回复。
# 例如 https://voice.example.com/api/rtc/llm/chat/completions
# LLM_API_KEY 是自定义桥接鉴权令牌，需保密；不是 Qwen 的 API_KEY。
# LLM_MODEL 仅是桥接协议名称（如 manji-langgraph），实际访谈仍用现有 Qwen 配置。
MANJI_LANGGRAPH_RTC_LLM_API_URL=
MANJI_LANGGRAPH_RTC_LLM_API_KEY=
MANJI_LANGGRAPH_RTC_LLM_MODEL=
MANJI_LANGGRAPH_RTC_VOICE_ID=

# 腾讯事件回调 /api/rtc/events 的验签密钥，与控制台一致；要求 1~32 位英文字母或数字。
MANJI_LANGGRAPH_RTC_CALLBACK_KEY=

# 以下可选项与 client.py 默认值一致。
MANJI_LANGGRAPH_RTC_REGION=ap-guangzhou
MANJI_LANGGRAPH_RTC_TTS_MODEL=flow_02_turbo
MANJI_LANGGRAPH_RTC_LANGUAGE=zh
MANJI_LANGGRAPH_RTC_SPEED=1.0
MANJI_LANGGRAPH_RTC_USER_SIG_TTL_SECONDS=3600
MANJI_LANGGRAPH_RTC_LLM_TIMEOUT_SECONDS=35
# 语音模型调用会按上述时长减去 3 秒限制等待；文本/成文原有超时保持不变。
MANJI_LANGGRAPH_RTC_REQUEST_TIMEOUT_SECONDS=10
MANJI_LANGGRAPH_RTC_MAX_IDLE_SECONDS=60

# 普通通话默认启用腾讯语义断句（TurnDetectionMode=3）。
# low 适合回忆、长段讲述，给用户思考和组织语言的时间；可选 low/medium/high/auto。
# https://cloud.tencent.com/document/product/647/117799
MANJI_LANGGRAPH_RTC_SEMANTIC_TURN_DETECTION=true
MANJI_LANGGRAPH_RTC_SEMANTIC_EAGERNESS=low
# 需要回退到原来的自动语音断句时，将 SEMANTIC_TURN_DETECTION 设为 false。
# 修改后重启后端，并结束旧通话、重新连接；现存腾讯任务不会热更新。
